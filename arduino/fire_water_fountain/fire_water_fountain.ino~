void loop() 
{
  static bool first_time=true;
  if(first_time)
  {
    if(use_pumps)
    {
      for(int p=0;p<NUMBER_OF_PUMPS;p++)
      {
        pump_controller[p].printPumpInfo();
      }
    }
    first_time=false;
  }
  // put your main code here, to run repeatedly:

  if(use_pumps)
  {
    if(run_tests)
    {
      if(test_pumps)
      {
        if(!pump_test())
        {
          test_pumps = false;
        }
      }
    }
    else
    {
      // read pump program toggle
      readPumpProgramButton();

      runPumpProgram();
    }
  }

  if(use_leds)
  {
    if(run_tests && test_leds)
    {
      led_test();
    }
    else
    {
      //read button presses
      readLEDProgramButton();

      runLEDProgram();
    }
  }
}
